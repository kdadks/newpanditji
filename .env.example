# ==============================================================================
# Pandit Rajesh Joshi Platform - Environment Configuration Template
# Copy this file to .env and populate the required values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE CLIENT & SUPABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Target Shared Supabase Project URL (Project ref: gsqfaguqsmnuoeuhpxro)
NEXT_PUBLIC_SUPABASE_URL=https://gsqfaguqsmnuoeuhpxro.supabase.co

# Schema for the Panditji platform in the shared Supabase instance
NEXT_PUBLIC_SUPABASE_SCHEMA=panditji

# Your Supabase Anon / Publishable Client Key (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# ------------------------------------------------------------------------------
# 2. CONTACT FORM EMAIL SERVICE (Required for /api/contact)
# ------------------------------------------------------------------------------
# Gmail account address used by Nodemailer to dispatch devotee booking & ceremony inquiries
GMAIL_USER=your_gmail_address@gmail.com

# Google App Password (16 characters, generated from Google Account Security -> App Passwords)
# NOTE: Do NOT use your regular Google account login password.
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# ------------------------------------------------------------------------------
# 3. ANALYTICS & TRACKING (Optional)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# If omitted, the client will fall back to querying the database table 'site_metadata'
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 4. MAINTENANCE & CLI SCRIPTS ONLY (Never expose to client or frontend!)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Project Settings -> API -> service_role secret)
# Required for running: npm run migrate, npm run migrate:images, cleanup-db.ts
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Direct PostgreSQL Connection String
# Required for running: npm run migrate:pg17 (scripts/supabase-pg17-migration.mjs)
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:65432/postgres
DATABASE_URL=postgres://postgres.your_ref:your_password@aws-0-eu-west-1.pooler.supabase.com:65432/postgres
